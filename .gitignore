# Publish code and reproduction experiment evidence. Keep local-only files excluded.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/pyproject.toml
!/prepare_data.py
!/convert_mistral_safetensors.py
!/run_train_rotation.sh
!/run_eval_ptq.sh
!/run_full_experiment.py
!/environments/
!/jittor_spinquant/
!/experiments/
!/tests/

/environments/*
!/environments/jittor_environment.txt
!/environments/pytorch_environment.txt

/experiments/*
!/experiments/performance.csv
!/experiments/runner.log
!/experiments/report.md
!/experiments/checks/
!/experiments/environments/
!/experiments/training/
!/experiments/rotation_gains.csv
!/experiments/source/
!/experiments/loss_alignment_metrics.csv
!/experiments/shared/
!/experiments/summarize.py
!/experiments/results/
!/experiments/publication_manifest.json
!/experiments/logs/
!/experiments/training_loss.csv
!/experiments/summary_status.json
!/experiments/source_sha256.json
!/experiments/figures/
!/experiments/protocol.json
!/experiments/input_sha256.json
!/experiments/alignment.csv
!/experiments/shared_sha256.json
!/experiments/download_sha256.json
!/experiments/status.json
!/experiments/gpu_samples.jsonl
!/experiments/results.csv
!/experiments/evidence_audit.json
!/experiments/training_summary.csv

/tests/*
!/tests/test_full_experiment.py
!/tests/test_gptq_math.py
!/tests/test_publication.py

# Development diagnostics are preserved in the experiment source snapshot only.
/jittor_spinquant/tools/diag_forward.py
/jittor_spinquant/tools/smoke_real.py

# Do not include caches, notebook backups, outputs or model artifacts.
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.bak*
*.egg-info/
*.pid
.venv/
venv/
*.npy
*.bin
*.pt
*.pth
*.safetensors
*.parquet
*.mov
*.MOV
*.mp4
*.pptx
*.xlsx
